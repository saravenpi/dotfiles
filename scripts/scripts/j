#!/usr/bin/env bash

_has() {
    command -v "$1" >/dev/null 2>&1
}

journal_use_color() {
    [ "${CLICOLOR_FORCE:-0}" = "1" ] && return 0
    [ "${CLICOLOR:-1}" = "0" ] && return 1
    [ -t 1 ] || return 1
    [ "${TERM:-}" != "dumb" ] || return 1
}

journal_dir_path() {
    if [ -z "${BRAIN:-}" ]; then
        echo "BRAIN is not set"
        return 1
    fi

    printf '%s/Journal\n' "$BRAIN"
}

journal_template_path() {
    if [ -z "${BRAIN:-}" ]; then
        echo "BRAIN is not set"
        return 1
    fi

    printf '%s/Templates/daily_template.md\n' "$BRAIN"
}

journal_is_date() {
    printf '%s\n' "$1" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
}

journal_shifted_date() {
    case "$(uname -s)" in
        Darwin)
            date -v"$1"d +%F
            ;;
        Linux)
            date -d "$1 day" +%F
            ;;
        *)
            echo "Unsupported platform for date offsets"
            return 1
            ;;
    esac
}

journal_file_for_date() {
    local target_date

    target_date="${1:-$(date +%F)}"
    printf '%s/%s.md\n' "$(journal_dir_path)" "$target_date"
}

journal_date_from_path() {
    local path name

    path="$1"
    name="$(basename "$path")"
    printf '%s\n' "${name%.md}"
}

journal_section_heading() {
    case "$1" in
        dream)
            printf '## Rêve\n'
            ;;
        journal)
            printf '## Journal\n'
            ;;
        *)
            echo "Unknown journal section: $1"
            return 1
            ;;
    esac
}

journal_section_legacy_heading() {
    case "$1" in
        dream)
            printf '## Rêve 🌌\n'
            ;;
        journal)
            printf '## Journal 📔\n'
            ;;
        *)
            echo "Unknown journal section: $1"
            return 1
            ;;
    esac
}

journal_render_template() {
    local target_date template

    target_date="$1"
    template="$(journal_template_path)"

    sed \
        -e "s/{{date}}/$target_date/g" \
        -e "s/{{journal_alias}}/Journal $target_date/g" \
        -e "s/{{daily_alias}}/Daily $target_date/g" \
        "$template"
}

journal_bootstrap_content() {
    local target_date

    target_date="$1"

    if [ -f "$(journal_template_path)" ]; then
        journal_render_template "$target_date"
        return 0
    fi

    cat <<EOF
---
id: $target_date
aliases:
  - Journal $target_date
  - Daily $target_date
tags: [journal, daily]
date: $target_date
---

# $target_date

---
## Rêve


---
## Journal

EOF
}

journal_ensure_date() {
    local target_date file dir

    target_date="${1:-$(date +%F)}"
    dir="$(journal_dir_path)" || return 1
    file="$(journal_file_for_date "$target_date")"

    mkdir -p "$dir"

    if [ ! -f "$file" ]; then
        journal_bootstrap_content "$target_date" > "$file"
    fi

    printf '%s\n' "$file"
}

journal_open_date() {
    local file editor_cmd

    file="$(journal_ensure_date "$1")" || return 1
    editor_cmd="${EDITOR:-nvim}"

    if _has "$editor_cmd"; then
        "$editor_cmd" "$file"
        return
    fi

    if _has nvim; then
        nvim "$file"
        return
    fi

    printf '%s\n' "$file"
}

journal_insert_line() {
    local target_date section_key line file tmp heading legacy_heading

    target_date="$1"
    section_key="$2"
    line="$3"

    [ -n "$line" ] || {
        echo "Nothing to write"
        return 1
    }

    heading="$(journal_section_heading "$section_key")" || return 1
    legacy_heading="$(journal_section_legacy_heading "$section_key")" || return 1
    file="$(journal_ensure_date "$target_date")" || return 1
    tmp="$(mktemp)" || return 1

    awk -v heading="$heading" -v legacy_heading="$legacy_heading" -v line="$line" '
        function is_target(value) {
            return value == heading || value == legacy_heading
        }

        {
            if (pending) {
                print ""
                print line
                inserted = 1
                pending = 0
                if ($0 == "") {
                    next
                }
            }

            if (is_target($0) && !inserted) {
                print
                pending = 1
                next
            }

            print
        }

        END {
            if (pending && !inserted) {
                print ""
                print line
                inserted = 1
            }

            if (!inserted) {
                if (NR > 0) {
                    print ""
                }
                print heading
                print ""
                print line
            }
        }
    ' "$file" > "$tmp" && mv "$tmp" "$file"
}

journal_recent_pick() {
    local dir pick pick_date

    dir="$(journal_dir_path)" || return 1

    if ! compgen -G "$dir/*.md" >/dev/null; then
        echo "No journal notes found"
        return 1
    fi

    if _has fzf; then
        pick="$(ls -1t "$dir"/*.md 2>/dev/null | while IFS= read -r path; do journal_date_from_path "$path"; done | fzf)"
        [ -n "$pick" ] || return 0
        pick_date="$pick"
        journal_open_date "$pick_date"
        return
    fi

    ls -1t "$dir"/*.md 2>/dev/null | while IFS= read -r path; do journal_date_from_path "$path"; done | head -20
}

journal_format_match_results() {
    local use_color pattern date_color line_color match_color reset

    use_color="$1"
    pattern="$2"
    date_color=""
    line_color=""
    match_color=""
    reset=""

    if [ "$use_color" = "1" ]; then
        date_color="$(printf '\033[1;36m')"
        line_color="$(printf '\033[2;37m')"
        match_color="$(printf '\033[1;31m')"
        reset="$(printf '\033[0m')"
    fi

    awk \
        -v use_color="$use_color" \
        -v date_color="$date_color" \
        -v line_color="$line_color" \
        -v match_color="$match_color" \
        -v reset="$reset" \
        -v pattern="$pattern" '
        function highlight(s,    result, lc, idx, mlen) {
            if (use_color != "1" || pattern == "") return s
            result = ""
            lc = tolower(s)
            pat = tolower(pattern)
            while ((idx = index(lc, pat)) > 0) {
                mlen = length(pat)
                result = result substr(s, 1, idx - 1) match_color substr(s, idx, mlen) reset
                s = substr(s, idx + mlen)
                lc = substr(lc, idx + mlen)
            }
            return result s
        }

        {
            first_sep = index($0, ":")
            if (!first_sep) {
                print
                next
            }

            file = substr($0, 1, first_sep - 1)
            rest = substr($0, first_sep + 1)
            second_sep = index(rest, ":")

            if (!second_sep) {
                sub(/^.*\//, "", file)
                sub(/\.md$/, "", file)
                if (use_color == "1") {
                    printf "%s%s%s\n", date_color, file, reset
                } else {
                    print file
                }
                next
            }

            line = substr(rest, 1, second_sep - 1)
            text = substr(rest, second_sep + 1)

            sub(/^.*\//, "", file)
            sub(/\.md$/, "", file)

            if (use_color == "1") {
                printf "%s%s%s:%s%s%s:%s\n", date_color, file, reset, line_color, line, reset, highlight(text)
            } else {
                printf "%s:%s:%s\n", file, line, text
            }
        }
    '
}

journal_search() {
    local dir use_color

    dir="$(journal_dir_path)" || return 1
    [ -n "$*" ] || {
        echo "Usage: j s <query>"
        return 1
    }

    use_color=0
    if journal_use_color; then
        use_color=1
    fi

    if _has rg; then
        rg -n --smart-case -- "$*" "$dir" | journal_format_match_results "$use_color" "$*"
        return "${PIPESTATUS[0]}"
    fi

    grep -Rni -- "$*" "$dir" | journal_format_match_results "$use_color" "$*"
    return "${PIPESTATUS[0]}"
}

journal_help() {
    cat <<'EOF'
Usage: j [text]
       j [command] [args]

Commands:
  j                    Open today's note
  j "text"             Append a timestamped line to Journal
  j a "text"           Append a timestamped line to Journal
  j r "text"           Append a timestamped line to Rêve
  j t                  Open today's note
  j y                  Open yesterday's note
  j tm                 Open tomorrow's note
  j 2026-04-22         Open a specific note by date
  j l                  Pick a recent note with fzf
  j s "query"          Search all journal notes
  j -h | j --help      Show this help
EOF
}

main() {
    local cmd target_date

    [ -n "${BRAIN:-}" ] || {
        echo "BRAIN is not set"
        return 1
    }

    if [ "$#" -eq 0 ]; then
        journal_open_date "$(date +%F)"
        return
    fi

    cmd="$1"

    case "$cmd" in
        -h|--help|help)
            journal_help
            ;;
        t|today)
            journal_open_date "$(date +%F)"
            ;;
        y|yesterday)
            target_date="$(journal_shifted_date -1)" || return 1
            journal_open_date "$target_date"
            ;;
        tm|tomorrow)
            target_date="$(journal_shifted_date +1)" || return 1
            journal_open_date "$target_date"
            ;;
        a|add)
            shift
            journal_insert_line "$(date +%F)" journal "- [$(date +%H:%M)] $*"
            ;;
        r|dream)
            shift
            journal_insert_line "$(date +%F)" dream "- [$(date +%H:%M)] $*"
            ;;
        l|list|recent)
            journal_recent_pick
            ;;
        s|search)
            shift
            journal_search "$*"
            ;;
        *)
            if journal_is_date "$cmd"; then
                journal_open_date "$cmd"
                return
            fi

            journal_insert_line "$(date +%F)" journal "- [$(date +%H:%M)] $*"
            ;;
    esac
}

main "$@"
