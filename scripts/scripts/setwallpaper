#!/bin/sh
#
# setwallpaper - set the desktop wallpaper on Wayland, X11 and macOS.
#
# Installed with the scripts package (scripts/scripts/setwallpaper ->
# ~/scripts/setwallpaper) and reachable as `setwallpaper` from anywhere.
#
# The chosen image is written to a single state file,
# $XDG_CONFIG_HOME/wallpaper (usually ~/.config/wallpaper), which is the source
# of truth the compositor snippets below are generated from. Sway gets
# ~/.config/sway/wallpaper.conf (`output * bg <image> fill`, included by the
# sway config), Hyprland gets ~/.config/hypr/wallpaper.conf (`exec-once = swaybg
# ...`, included by the Hyprland config) and niri gets
# ~/.config/niri/wallpaper.kdl, so the wallpaper is still there after the
# compositor reloads or the session restarts. Every other Wayland compositor
# falls back to a `swaybg` daemon, X11 to the usual tools, and macOS to
# `osascript`.
#
# Usage:
#   setwallpaper <image>       set the wallpaper for the current session
#   setwallpaper -a <image>    macOS: apply to every Space, not just the first
#   setwallpaper -h            show this help
#
# Options:
#   -a, --all-spaces   macOS only: set the picture on every desktop/Space
#   -h, --help         show this help
#
# Compositor / desktop support:
#   Wayland   sway (native `output bg`), Hyprland (hyprpaper or swaybg), niri
#             (swaybg), any other wlr-layer-shell compositor with swaybg installed
#   X11       feh, xwallpaper, nitrogen, hsetroot
#   Desktop   GNOME (gsettings), KDE (plasma-apply-wallpaperimage),
#             XFCE (xfconf-query)
#   macOS     System Events via osascript
#

set -eu
# shellcheck disable=SC3040
set -o pipefail 2>/dev/null || true

have() { command -v "$1" >/dev/null 2>&1; }

die() {
    printf 'setwallpaper: %s\n' "$*" >&2
    exit 1
}

usage() {
    awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
}

config_home() {
    if [ -n "${XDG_CONFIG_HOME:-}" ]; then
        printf '%s\n' "$XDG_CONFIG_HOME"
    else
        printf '%s\n' "$HOME/.config"
    fi
}

# Absolute path for the image, so the stored value keeps working no matter
# where the file was referenced from.
absolute_path() {
    # shellcheck disable=SC2088  # the patterns match a literal ~/, not $HOME
    case "$1" in
        /*) printf '%s\n' "$1" ;;
        "~"|"~/"*) printf '%s\n' "$HOME${1#\~}" ;;
        *)
            printf '%s/%s\n' \
                "$(cd -- "$(dirname -- "$1")" && pwd -P)" \
                "$(basename -- "$1")"
            ;;
    esac
}

# Sway splits commands on spaces, so a path with spaces needs quoting.
sway_value() {
    case "$1" in
        *[!A-Za-z0-9_./+~-]*)
            printf '"%s"\n' "$(printf '%s' "$1" | sed 's/[\\"]/\\&/g')"
            ;;
        *) printf '%s\n' "$1" ;;
    esac
}

# Start a detached command without tying it to this shell's job control.
spawn() {
    if have setsid; then
        setsid "$@" >/dev/null 2>&1 &
    else
        "$@" >/dev/null 2>&1 &
    fi
}

write_state() {
    mkdir -p -- "$STATE_DIR"
    printf '%s\n' "$IMAGE" > "$STATE_FILE"
}

# Sway draws the wallpaper itself and re-applies it from the included snippet on
# every `swaymsg reload`, so there is no daemon to keep alive. The snippet keeps
# a home-relative path when it can (`~` is expanded by sway), so the dotfiles
# repository is not tied to one machine's home directory.
apply_sway() {
    stored="$IMAGE"
    # shellcheck disable=SC2088  # a literal ~ is stored for sway to expand
    case "$IMAGE" in
        "$HOME"/*) stored="~/${IMAGE#"$HOME"/}" ;;
    esac
    mkdir -p -- "$(dirname -- "$SWAY_CONF")"
    {
        printf '# Generated by setwallpaper. Do not edit; run setwallpaper instead.\n'
        printf 'output * bg %s fill\n' "$(sway_value "$stored")"
    } > "$SWAY_CONF"
    if have swaymsg; then
        swaymsg "output * bg $(sway_value "$IMAGE") fill" >/dev/null 2>&1 || true
    fi
}

# niri has no wallpaper of its own and no runtime IPC for one: the session runs
# a background tool (swaybg) and the include only records the image for the next
# start. The `include "wallpaper.kdl"` line is never added to the user's config
# here - it is added once by hand and live-reloaded afterwards.
apply_niri() {
    if [ -f "$NIRI_CONF" ]; then
        mkdir -p -- "$(dirname -- "$NIRI_INCLUDE")"
        {
            printf '// Generated by setwallpaper. Do not edit; run setwallpaper instead.\n'
            printf 'spawn-at-startup "swaybg" "-i" "%s" "-m" "fill"\n' "$IMAGE"
        } > "$NIRI_INCLUDE"
    fi
}

# Hyprland draws no wallpaper itself either: the session keeps a background tool
# (hyprpaper or swaybg) and the include only records the image for the next
# start. The live change goes through restart_hyprpaper/restart_swaybg below.
apply_hypr() {
    mkdir -p -- "$(dirname -- "$HYPR_CONF")"
    {
        printf '# Generated by setwallpaper. Do not edit; run setwallpaper instead.\n'
        printf 'exec-once = swaybg -i %s -m fill\n' "$IMAGE"
    } > "$HYPR_CONF"
}

restart_swaybg() {
    have swaybg || return 1
    pkill -x swaybg 2>/dev/null || true
    spawn swaybg -i "$IMAGE" -m fill
}

restart_hyprpaper() {
    have hyprctl || return 1
    have hyprpaper || return 1
    hyprctl hyprpaper unload all >/dev/null 2>&1 || true
    hyprctl hyprpaper preload "$IMAGE" >/dev/null 2>&1 || true
    hyprctl hyprpaper wallpaper ",$IMAGE" >/dev/null 2>&1 || true
}

apply_macos() {
    have osascript || die "osascript not found"

    if [ "$ALL_SPACES" = 1 ]; then
        osascript -e "tell application \"System Events\" to tell every desktop to set picture to \"$IMAGE\"" >/dev/null 2>&1 || die "could not set the wallpaper"
        # Spaces are created lazily; walk through the existing ones so each gets
        # the picture instead of only the one that is visible.
        step=0
        while [ "$step" -lt 10 ]; do
            osascript -e 'tell application "System Events" to key code 124 using control down' >/dev/null 2>&1 || true
            sleep 0.5
            osascript -e "tell application \"System Events\" to tell every desktop to set picture to \"$IMAGE\"" >/dev/null 2>&1 || true
            step=$((step + 1))
        done
        printf 'wallpaper set across macOS spaces: %s\n' "$IMAGE"
        return 0
    fi

    osascript -e "tell application \"System Events\" to tell every desktop to set picture to \"$IMAGE\"" >/dev/null 2>&1 ||
        die "could not set the wallpaper"
}

apply_linux() {
    desktop="${XDG_CURRENT_DESKTOP:-}"

    # Wayland compositors first: the user picked a wallpaper for the session
    # that is actually running, not for whatever defaults the distro shipped.
    if [ -n "${SWAYSOCK:-}" ] && have swaymsg; then
        apply_sway
        printf 'wallpaper set with sway: %s\n' "$IMAGE"
        return 0
    fi

    if [ -n "${NIRI_SOCKET:-}" ]; then
        apply_niri
        if restart_swaybg; then
            printf 'wallpaper set with swaybg (niri): %s\n' "$IMAGE"
            return 0
        fi
        die "swaybg not found; install it to set the wallpaper under niri"
    fi

    if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        apply_hypr
        if restart_hyprpaper || restart_swaybg; then
            printf 'wallpaper set (Hyprland): %s\n' "$IMAGE"
            return 0
        fi
        die "install hyprpaper or swaybg to set the wallpaper under Hyprland"
    fi

    case "$desktop" in
        *GNOME*|*Unity*)
            if have gsettings; then
                gsettings set org.gnome.desktop.background picture-uri "file://$IMAGE" >/dev/null 2>&1 || true
                gsettings set org.gnome.desktop.background picture-uri-dark "file://$IMAGE" >/dev/null 2>&1 || true
                printf 'wallpaper set with gsettings: %s\n' "$IMAGE"
                return 0
            fi
            ;;
        *KDE*|*Plasma*)
            if have plasma-apply-wallpaperimage; then
                plasma-apply-wallpaperimage "$IMAGE" >/dev/null 2>&1 || true
                printf 'wallpaper set with plasma-apply-wallpaperimage: %s\n' "$IMAGE"
                return 0
            fi
            ;;
        *XFCE*)
            if have xfconf-query; then
                xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitor0/workspace0/last-image -s "$IMAGE" >/dev/null 2>&1 || true
                printf 'wallpaper set with xfconf-query: %s\n' "$IMAGE"
                return 0
            fi
            ;;
    esac

    # Any other Wayland compositor that speaks wlr-layer-shell.
    if [ -n "${WAYLAND_DISPLAY:-}" ] && restart_swaybg; then
        printf 'wallpaper set with swaybg: %s\n' "$IMAGE"
        return 0
    fi

    if [ -n "${DISPLAY:-}" ]; then
        if have feh; then
            feh --bg-fill "$IMAGE"
            return 0
        fi
        if have xwallpaper; then
            xwallpaper --zoom "$IMAGE"
            return 0
        fi
        if have nitrogen; then
            nitrogen --set-zoom-fill --save "$IMAGE"
            return 0
        fi
        if have hsetroot; then
            hsetroot -fill "$IMAGE"
            return 0
        fi
    fi

    # Last resort: a desktop that exposes its wallpaper through gsettings but
    # announces a desktop name we do not know. A graphical session has to be
    # present, or this would report success on a bare TTY and change nothing.
    if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && have gsettings; then
        gsettings set org.gnome.desktop.background picture-uri "file://$IMAGE" >/dev/null 2>&1 || true
        gsettings set org.gnome.desktop.background picture-uri-dark "file://$IMAGE" >/dev/null 2>&1 || true
        printf 'wallpaper set with gsettings: %s\n' "$IMAGE"
        return 0
    fi

    die "no supported wallpaper tool found (tried sway, niri, Hyprland, swaybg, gsettings, feh, xwallpaper, nitrogen, hsetroot)"
}

ALL_SPACES=0
IMAGE_ARG=""
while [ $# -gt 0 ]; do
    case "$1" in
        -a|--all-spaces) ALL_SPACES=1 ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            IMAGE_ARG="${1:-}"
            break
            ;;
        -*) die "unknown option: $1 (try --help)" ;;
        *) IMAGE_ARG="$1" ;;
    esac
    shift
done

[ -n "$IMAGE_ARG" ] || {
    usage >&2
    exit 2
}

[ -f "$IMAGE_ARG" ] || die "file '$IMAGE_ARG' not found"
IMAGE="$(absolute_path "$IMAGE_ARG")"

STATE_DIR="$(config_home)"
STATE_FILE="$STATE_DIR/wallpaper"
SWAY_CONF="$STATE_DIR/sway/wallpaper.conf"
HYPR_CONF="$STATE_DIR/hypr/wallpaper.conf"
NIRI_CONF="$STATE_DIR/niri/config.kdl"
NIRI_INCLUDE="$STATE_DIR/niri/wallpaper.kdl"

write_state

case "$(uname -s)" in
    Darwin) apply_macos ;;
    *) apply_linux ;;
esac
