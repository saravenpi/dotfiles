#!/bin/sh
#
# tido - dotfiles linker; a dependency-free replacement for GNU Stow.
#
# Installed as part of the scripts package (scripts/scripts/tido -> ~/scripts/tido)
# and reachable as `tido` from anywhere. The repository root comes from
# $DOTFILES when it is set (tiroir exports it), otherwise it is found by
# walking up from this script's own resolved path, so it works whether it is
# invoked as <repo>/scripts/scripts/tido, through the ~/scripts symlink, or
# from PATH.
#
# Links the contents of each package directory into a target directory
# (default: $HOME). Packages are the non-hidden directories at the root of
# this repository (fonts, nvim, shell, bash, zsh, tmux, vim, mise,
# scripts); each path inside a package mirrors a path under the target, so
# nvim/.config/nvim/init.lua becomes ~/.config/nvim/init.lua.
#
# Unlike stow, conflicts never break the run: a real file or directory in
# the way is moved into a timestamped backup directory before the symlink is
# created, and nothing is ever deleted silently.
#
# Usage:
#   tido link          [options] [package...]   create/refresh symlinks
#   tido unlink        [options] [package...]   remove links made by this repo
#   tido list          [options] [package...]   dry run, change nothing
#   tido clean         [options]                remove backup directories
#
# Options:
#   -t, --target DIR   directory to link into (default: $HOME)
#   -b, --backup DIR   where conflicting files are moved
#                      (default: <target>/.tido-backups/<timestamp>)
#       --no-backup    refuse to touch conflicting files instead
#   -n, --dry-run      preview actions without making changes
#   -v, --verbose      also print the source of each link
#   -h, --help         show this help
#
# Examples:
#   tido link                       # link every package into $HOME
#   tido link nvim tmux             # link only these packages
#   tido list                       # show what would happen
#   tido unlink nvim                # remove the nvim symlinks
#   tido clean                      # remove all backup directories
#

set -eu
# Ubuntu's dash treats `set` as a special builtin: an unsupported `-o
# pipefail` aborts the shell even behind `|| true`. Probe it in a subshell so
# the failure is contained, then enable it only where it exists.
# shellcheck disable=SC3040
if (set -o pipefail) 2>/dev/null; then
    set -o pipefail
fi

# Resolve a path to an absolute one with symlinks followed.
#
# GNU readlink -f does this in one call, but macOS before 12.3 and BusyBox do
# not have it. Fall back to following the link chain one hop at a time and
# resolving the parent directory with pwd -P, both of which POSIX sh provides.
real_path() {
    # shellcheck disable=SC3043
    local target link dir base
    target="$1"

    if link="$(readlink -f "$target" 2>/dev/null)" && [ -n "$link" ]; then
        printf '%s\n' "$link"
        return 0
    fi

    case "$target" in
        /*) ;;
        *) target="$(pwd -P)/$target" ;;
    esac

    while [ -L "$target" ]; do
        link="$(readlink "$target" 2>/dev/null)" || break
        [ -n "$link" ] || break
        case "$link" in
            /*) target="$link" ;;
            *) target="$(dirname "$target")/$link" ;;
        esac
    done

    dir="$(cd "$(dirname "$target")" 2>/dev/null && pwd -P)" || \
        dir="$(dirname "$target")"
    base="$(basename "$target")"
    if [ "$dir" = "/" ]; then
        printf '/%s\n' "$base"
    else
        printf '%s/%s\n' "$dir" "$base"
    fi
}

self_path() {
    # shellcheck disable=SC3043
    local target="$0"
    case "$target" in
        */*) ;;
        *) target="$(command -v "$0" 2>/dev/null || printf '%s' "$0")" ;;
    esac
    real_path "$target"
}

is_repo_root() {
    [ -f "$1/install.sh" ] && [ -f "$1/scripts/scripts/tido" ]
}

find_repo_root() {
    # shellcheck disable=SC3043
    local dir
    dir="$1"
    while [ -n "$dir" ] && [ "$dir" != "/" ] && [ "$dir" != "." ]; do
        if is_repo_root "$dir"; then
            printf '%s\n' "$dir"
            return 0
        fi
        dir="$(dirname "$dir")"
    done
    return 1
}

# $DOTFILES (set by tiroir) is the explicit answer; use it when it points at
# this checkout and fall back to the script location otherwise.
if [ -n "${DOTFILES:-}" ] && is_repo_root "$DOTFILES"; then
    SRC_DIR="$(real_path "$DOTFILES")"
else
    SRC_DIR="$(find_repo_root "$(dirname "$(self_path)")")" || {
        printf 'tido: cannot locate the dotfiles repository around %s\n' "$0" >&2
        exit 1
    }
fi

PLATFORM="$(uname -s 2>/dev/null || printf 'unknown')"

TARGET="${HOME:-}"
ACTION="link"
BACKUP_DIR=""
DO_BACKUP=1
VERBOSE=0
DRY_RUN=0
PACKAGES=""

created=0
backed_up=0
removed=0
conflicts=0
already_linked=0

SHARED_DIRS=""

if [ -t 1 ]; then
    C_RED='\033[0;31m'; C_GREEN='\033[0;32m'; C_YELLOW='\033[1;33m'
    C_BLUE='\033[0;34m'; C_NC='\033[0m'
else
    C_RED=''; C_GREEN=''; C_YELLOW=''; C_BLUE=''; C_NC=''
fi

info() { printf '%b::%b %s\n' "$C_BLUE" "$C_NC" "$*"; }
ok()   { printf '%b  +%b %s\n' "$C_GREEN" "$C_NC" "$*"; }
warn() { printf '%b  !%b %s\n' "$C_YELLOW" "$C_NC" "$*" >&2; }
err()  { printf '%b  x%b %s\n' "$C_RED" "$C_NC" "$*" >&2; }
die()  { err "$*"; exit 1; }

usage() {
    cat <<'EOF'
tido - link dotfiles into $HOME

Usage:
  tido link   [options] [package...]   create/refresh symlinks
  tido unlink [options] [package...]   remove links made by this repo
  tido list   [options] [package...]   dry run, change nothing
  tido clean  [options]                remove backup directories

Options:
  -t, --target DIR   link into DIR (default: $HOME)
  -b, --backup DIR   move conflicts into DIR
      --no-backup    refuse to touch conflicts
  -n, --dry-run      preview only
  -v, --verbose      print each link source
  -h, --help         show this help
EOF
}

resolve() {
    real_path "$1"
}

link_destination() {
    resolve "$1"
}

is_inside_repo() {
    # shellcheck disable=SC3043
    local resolved
    resolved="$(resolve "$1")"
    case "$resolved" in
        "$SRC_DIR"/*) return 0 ;;
        *) return 1 ;;
    esac
}

is_shared_dir() {
    case "$1" in
        .config|.local|.local/share) return 0 ;;
    esac
    [ -n "$SHARED_DIRS" ] || return 1
    case "
$SHARED_DIRS
" in
        *"
$1
"*) return 0 ;;
        *) return 1 ;;
    esac
}

# Print every directory that more than one package contributes to, one per
# line. This lives in its own function because macOS runs scripts with bash 3.2,
# whose command-substitution parser mistakes the `)` closing a case pattern for
# the end of the substitution and aborts with "syntax error near unexpected
# token `newline`". Keeping the `case` outside the $(...) keeps it portable.
parent_dirs() {
    # shellcheck disable=SC3043
    local pkg path rel anc
    for pkg in $1; do
        [ -n "$pkg" ] || continue
        find "$SRC_DIR/$pkg" -mindepth 1 2>/dev/null | while IFS= read -r path; do
            rel="${path#"$SRC_DIR/$pkg/"}"
            case "$rel" in
                */*)
                    anc="${rel%/*}"
                    while [ -n "$anc" ]; do
                        printf '%s\t%s\n' "$pkg" "$anc"
                        case "$anc" in
                            */*) anc="${anc%/*}" ;;
                            *) break ;;
                        esac
                    done
                    ;;
            esac
        done
    done | sort -u | cut -f2 | sort | uniq -d
}

collect_shared_dirs() {
    SHARED_DIRS="$(parent_dirs "$1")"
}

timestamp() { date +%Y%m%d_%H%M%S; }

backup_path() {
    # shellcheck disable=SC3043
    local path rel dest
    path="$1"
    rel="$2"
    dest="$BACKUP_DIR/$rel"

    if [ "$DO_BACKUP" -eq 0 ]; then
        err "conflict: $rel already exists (rerun with --backup to move it aside)"
        return 1
    fi

    if [ "$DRY_RUN" -eq 1 ]; then
        backed_up=$((backed_up + 1))
        ok "would back up: $rel"
        return 0
    fi

    mkdir -p -- "$(dirname "$dest")"
    if mv -- "$path" "$dest" 2>/dev/null; then
        backed_up=$((backed_up + 1))
        warn "moved aside: $rel (saved in $BACKUP_DIR)"
        return 0
    fi

    err "could not move aside: $rel"
    return 1
}

create_link() {
    # shellcheck disable=SC3043
    local src rel dst
    src="$1"
    rel="$2"
    dst="$TARGET/$rel"

    if [ "$DRY_RUN" -eq 1 ]; then
        created=$((created + 1))
        ok "would link: $rel"
        return 0
    fi

    mkdir -p -- "$(dirname "$dst")"
    ln -s -- "$(resolve "$src")" "$dst"
    created=$((created + 1))
    if [ "$VERBOSE" -eq 1 ]; then
        ok "$rel -> $src"
    else
        ok "$rel"
    fi
}

unfold_directory() {
    # shellcheck disable=SC3043
    local link rel old_dest child base
    link="$1"
    rel="$2"
    old_dest="$(link_destination "$link")"

    rm -f -- "$link"
    mkdir -p -- "$link"
    info "unfolded shared directory: $rel"
    for child in "$old_dest"/* "$old_dest"/.[!.]* "$old_dest"/..?*; do
        [ -e "$child" ] || [ -L "$child" ] || continue
        base="${child##*/}"
        [ "$base" = "." ] || [ "$base" = ".." ] && continue
        ln -s -- "$(resolve "$child")" "$link/$base"
    done
}

link_entry() {
    # shellcheck disable=SC3043
    local src rel dst child base src_res dst_dest dst_link
    src="$1"
    rel="$2"
    dst="$TARGET/$rel"

    if [ -L "$dst" ]; then
        src_res="$(resolve "$src")"
        dst_dest="$(link_destination "$dst")"
        dst_link="$(readlink "$dst" 2>/dev/null || true)"

        if [ "$dst_dest" = "$src_res" ]; then
            if [ "$dst_link" = "$src_res" ]; then
                already_linked=$((already_linked + 1))
                [ "$DRY_RUN" -eq 1 ] || [ "$VERBOSE" -eq 1 ] && ok "ok: $rel"
                return 0
            fi

            if [ "$DRY_RUN" -eq 1 ]; then
                created=$((created + 1))
                ok "would make absolute: $rel"
            else
                rm -f -- "$dst"
                create_link "$src" "$rel"
            fi
            return 0
        fi

        if [ -d "$src" ] && [ -d "$dst_dest" ] && is_inside_repo "$dst"; then
            if [ "$DRY_RUN" -eq 1 ]; then
                ok "would unfold shared directory: $rel"
            else
                unfold_directory "$dst" "$rel"
            fi
            for child in "$src"/* "$src"/.[!.]* "$src"/..?*; do
                [ -e "$child" ] || [ -L "$child" ] || continue
                base="${child##*/}"
                [ "$base" = "." ] || [ "$base" = ".." ] && continue
                link_entry "$child" "$rel/$base"
            done
            return 0
        fi

        warn "replacing stale symlink: $rel -> $dst_link"
        backup_path "$dst" "$rel" || { conflicts=$((conflicts + 1)); return 0; }
        create_link "$src" "$rel"
        return 0
    fi

    if [ -d "$src" ] && is_shared_dir "$rel"; then
        if [ -e "$dst" ] && [ ! -d "$dst" ]; then
            backup_path "$dst" "$rel" || { conflicts=$((conflicts + 1)); return 0; }
        fi
        if [ ! -d "$dst" ]; then
            if [ "$DRY_RUN" -eq 1 ]; then
                info "would create directory: $rel"
            else
                mkdir -p -- "$dst"
            fi
        fi
        for child in "$src"/* "$src"/.[!.]* "$src"/..?*; do
            [ -e "$child" ] || [ -L "$child" ] || continue
            base="${child##*/}"
            [ "$base" = "." ] || [ "$base" = ".." ] && continue
            link_entry "$child" "$rel/$base"
        done
        return 0
    fi

    if [ -d "$dst" ]; then
        if [ -d "$src" ]; then
            for child in "$src"/* "$src"/.[!.]* "$src"/..?*; do
                [ -e "$child" ] || [ -L "$child" ] || continue
                base="${child##*/}"
                [ "$base" = "." ] || [ "$base" = ".." ] && continue
                link_entry "$child" "$rel/$base"
            done
            return 0
        fi

        backup_path "$dst" "$rel" || { conflicts=$((conflicts + 1)); return 0; }
        create_link "$src" "$rel"
        return 0
    fi

    if [ -e "$dst" ]; then
        backup_path "$dst" "$rel" || { conflicts=$((conflicts + 1)); return 0; }
        create_link "$src" "$rel"
        return 0
    fi

    create_link "$src" "$rel"
}

unlink_entry() {
    # shellcheck disable=SC3043
    local src rel dst child base
    src="$1"
    rel="$2"
    dst="$TARGET/$rel"

    if [ -L "$dst" ]; then
        if is_inside_repo "$dst"; then
            removed=$((removed + 1))
            if [ "$DRY_RUN" -eq 1 ]; then
                ok "would remove: $rel"
            else
                rm -f -- "$dst"
                ok "removed: $rel"
            fi
        else
            warn "left alone (not ours): $rel"
        fi
        return 0
    fi

    if [ -d "$dst" ] && [ -d "$src" ]; then
        for child in "$src"/* "$src"/.[!.]* "$src"/..?*; do
            [ -e "$child" ] || [ -L "$child" ] || continue
            base="${child##*/}"
            [ "$base" = "." ] || [ "$base" = ".." ] && continue
            unlink_entry "$child" "$rel/$base"
        done
        [ "$DRY_RUN" -eq 0 ] && rmdir -- "$dst" 2>/dev/null || true
    fi
}

clean_backups() {
    # shellcheck disable=SC3043
    local root count found entry
    found=0
    count=0

    if [ -n "$BACKUP_DIR" ]; then
        if [ -e "$BACKUP_DIR" ] || [ -L "$BACKUP_DIR" ]; then
            found=1
            count=$((count + 1))
            if [ "$DRY_RUN" -eq 1 ]; then
                ok "would remove: $BACKUP_DIR"
            else
                rm -rf -- "$BACKUP_DIR"
                ok "removed: $BACKUP_DIR"
            fi
        fi
    fi

    root="$TARGET/.tido-backups"
    if [ -d "$root" ]; then
        found=1
        for entry in "$root"/*; do
            [ -e "$entry" ] || [ -L "$entry" ] || continue
            count=$((count + 1))
            if [ "$DRY_RUN" -eq 1 ]; then
                ok "would remove: ${entry#"$TARGET/"}"
            fi
        done
        if [ "$DRY_RUN" -eq 0 ]; then
            rm -rf -- "$root"
            ok "removed: .tido-backups ($count snapshot(s))"
        fi
    fi

    for entry in "$TARGET"/.config/config.old.*; do
        [ -e "$entry" ] || [ -L "$entry" ] || continue
        found=1
        count=$((count + 1))
        if [ "$DRY_RUN" -eq 1 ]; then
            ok "would remove: ${entry#"$TARGET/"}"
        else
            rm -rf -- "$entry"
            ok "removed: ${entry#"$TARGET/"}"
        fi
    done

    if [ "$found" -eq 0 ]; then
        info "no backups found in $TARGET"
    else
        if [ "$DRY_RUN" -eq 1 ]; then
            info "Would remove $count backup path(s)."
        else
            info "Cleaned $count backup path(s)."
        fi
    fi
}

[ $# -eq 0 ] && { usage; exit 0; }

while [ $# -gt 0 ]; do
    case "$1" in
        link|stow)       ACTION="link" ;;
        unlink|remove|unstow|destow) ACTION="unlink" ;;
        list|check)      ACTION="link"; DRY_RUN=1 ;;
        clean|prune)     ACTION="clean" ;;
        -t|--target)     shift; [ $# -gt 0 ] || die "--target needs a directory"; TARGET="$1" ;;
        -b|--backup)     shift; [ $# -gt 0 ] || die "--backup needs a directory"; BACKUP_DIR="$1" ;;
        --no-backup)     DO_BACKUP=0 ;;
        -n|--dry-run)    DRY_RUN=1 ;;
        -v|--verbose)    VERBOSE=1 ;;
        -h|--help)       usage; exit 0 ;;
        --)              shift; PACKAGES="$PACKAGES $*"; break ;;
        -*)              die "unknown option: $1 (try --help)" ;;
        *)               PACKAGES="$PACKAGES $1" ;;
    esac
    shift
done

if [ "$ACTION" = "clean" ]; then
    [ -n "$TARGET" ] || die "no target directory (set \$HOME or pass --target)"
    clean_backups
    exit 0
fi

[ -n "$TARGET" ] || die "no target directory (set \$HOME or pass --target)"
[ -d "$SRC_DIR" ] || die "cannot find the dotfiles directory"

if [ -z "$BACKUP_DIR" ]; then
    BACKUP_DIR="$TARGET/.tido-backups/$(timestamp)"
fi

# Desktop packages that only make sense on Linux. They are skipped when
# linking every package on macOS; naming one explicitly still links it, and
# unlink still visits them so links left by an older run can be removed.
is_linux_only_package() {
    case "$1" in
        foot|hypr|mako|niri|sway|waybar|widgets) return 0 ;;
    esac
    return 1
}

collect_packages() {
    # shellcheck disable=SC3043
    local p_name p_entry
    if [ -n "$PACKAGES" ]; then
        for p_name in $PACKAGES; do
            [ -d "$SRC_DIR/$p_name" ] || die "unknown package: $p_name"
            printf '%s\n' "$p_name"
        done
        return 0
    fi
    for p_entry in "$SRC_DIR"/*; do
        [ -d "$p_entry" ] || continue
        p_name="${p_entry##*/}"
        case "$p_name" in
            .*) continue ;;
        esac
        if [ "$ACTION" != "unlink" ] && [ "$PLATFORM" = "Darwin" ] && is_linux_only_package "$p_name"; then
            continue
        fi
        printf '%s\n' "$p_name"
    done
}

[ "$DRY_RUN" -eq 0 ] && mkdir -p -- "$TARGET"

all_packages="$(collect_packages)"
[ -n "$all_packages" ] || die "no packages found in $SRC_DIR"

case "$ACTION" in
    link)
        [ "$DRY_RUN" -eq 1 ] && info "Dry run: nothing will be changed"
        info "Linking into: $TARGET"
        info "Source:       $SRC_DIR"
        ;;
    unlink)
        info "Unlinking from: $TARGET"
        ;;
esac

collect_shared_dirs "$all_packages"

for pkg in $all_packages; do
    [ -n "$pkg" ] || continue
    for entry in "$SRC_DIR/$pkg"/* "$SRC_DIR/$pkg"/.[!.]* "$SRC_DIR/$pkg"/..?*; do
        [ -e "$entry" ] || [ -L "$entry" ] || continue
        base="${entry##*/}"
        [ "$base" = "." ] || [ "$base" = ".." ] && continue
        rel="${entry#"$SRC_DIR/$pkg/"}"
        if [ "$ACTION" = "unlink" ]; then
            unlink_entry "$entry" "$rel"
        else
            link_entry "$entry" "$rel"
        fi
    done
done

printf '\n'
if [ "$ACTION" = "unlink" ]; then
    if [ "$DRY_RUN" -eq 1 ]; then
        info "Would remove $removed link(s)."
    else
        info "Removed $removed link(s)."
    fi
else
    if [ "$DRY_RUN" -eq 1 ]; then
        if [ "$created" -eq 0 ] && [ "$backed_up" -eq 0 ]; then
            info "All $already_linked path(s) are already linked and up to date."
        else
            info "Would link $created path(s); would move aside $backed_up conflicting path(s) ($already_linked already up to date)."
        fi
    else
        if [ "$created" -eq 0 ] && [ "$backed_up" -eq 0 ]; then
            info "All $already_linked path(s) are already linked and up to date."
        else
            info "Linked $created path(s); moved aside $backed_up conflicting path(s) ($already_linked already up to date)."
            [ "$backed_up" -gt 0 ] && info "Backups kept in: $BACKUP_DIR"
        fi
    fi
fi

if [ "$conflicts" -gt 0 ]; then
    err "$conflicts path(s) could not be handled"
    exit 1
fi
