#!/usr/bin/env bash
# tube-proxy — SOCKS proxy through lucy, borrowing its home IP for yt-dlp.
# Requires an ssh session from lucy with: ssh -R 2222:localhost:22 ruche
# (or RemoteForward 2222 localhost:22 in lucy's ~/.ssh/config for the ruche host).
set -euo pipefail

PORT=1080
RPORT=2222
LUSER=fangafunk

if [[ "${1:-}" == "stop" ]]; then
  pkill -f "ssh -D $PORT -N -p $RPORT $LUSER@localhost" 2>/dev/null || true
  echo "tube-proxy: stopped"
  exit 0
fi

if nc -z localhost $RPORT 2>/dev/null; then
  if nc -z localhost $PORT 2>/dev/null; then
    echo "tube-proxy: already running on :$PORT"
  else
    ssh -D $PORT -N -f -p $RPORT "$LUSER@localhost"
    echo "tube-proxy: started on :$PORT (exit via lucy)"
  fi
  echo "tube-proxy: export TUBE_PROXY=socks5://localhost:$PORT"
else
  echo "tube-proxy: lucy's forward not detected on :$RPORT" >&2
  echo "tube-proxy: on lucy, use: ssh -R 2222:localhost:22 ruche" >&2
  echo "tube-proxy: (tube will fall back to kome meanwhile)" >&2
  exit 1
fi
