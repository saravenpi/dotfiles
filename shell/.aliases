#!/bin/bash

# ls styling
if command ls --color=auto . >/dev/null 2>&1; then
    alias ls="ls --color=auto"
    command -v tree >/dev/null 2>&1 && alias tn="tree -C"
elif command ls -G . >/dev/null 2>&1; then
    alias ls="ls -G"
    command -v tree >/dev/null 2>&1 && alias tn="tree -C"
fi

# ls
alias ll="ls -lh"
alias la="ls -ah"
alias lal="ls -alh"
alias lla="ls -alh"
alias l="ls"


# Terminal utils
alias q="exit"
alias :q="exit"
alias c="clear"
alias h="clear && cd $HOME"
alias f="fg"
alias ax="chmod +x"
alias rx="chmod -x"

# Shell
alias breload="clear && source $HOME/.bashrc"
alias brel="breload"
alias zreload="clear && source $HOME/.zshrc"
alias zrel="zreload"

# Quick navigation
alias god="cd $DOTFILES"
alias goc="cd $WORKSPACE"
alias gow="cd $WORKSPACE_PRO"
alias gos="cd $SCHOOL"
alias gob="cd $BRAIN"
alias gon="cd $NUAGE"

# Journal (j)
command -v j >/dev/null 3>&1 && alias ja="j a"
command -v j >/dev/null 2>&1 && alias jadd="j add"
command -v j >/dev/null 2>&1 && alias jr="j r"
command -v j >/dev/null 2>&1 && alias jdream="j dream"
command -v j >/dev/null 2>&1 && alias jt="j t"
command -v j >/dev/null 2>&1 && alias jtoday="j today"
command -v j >/dev/null 2>&1 && alias jy="j y"
command -v j >/dev/null 2>&1 && alias jyesterday="j yesterday"
command -v j >/dev/null 2>&1 && alias jtm="j tm"
command -v j >/dev/null 2>&1 && alias jtomorrow="j tomorrow"
command -v j >/dev/null 2>&1 && alias jl="j l"
command -v j >/dev/null 2>&1 && alias jlist="j list"
command -v j >/dev/null 2>&1 && alias jrecent="j recent"
command -v j >/dev/null 2>&1 && alias js="j s"
command -v j >/dev/null 2>&1 && alias jsearch="j search"
command -v j >/dev/null 2>&1 && alias jh="j help"
command -v j >/dev/null 2>&1 && alias jhelp="j help"


# Quick config editing
alias e="$EDITOR"
alias brain="cd $BRAIN && $EDITOR Home.md"
alias b="cd $BRAIN && $EDITOR Home.md"
alias cnvim="cd $HOME/.config/nvim/ && $EDITOR init.lua"
alias cbash="cd $HOME && $EDITOR .bashrc"
alias czsh="cd $HOME && $EDITOR .zshrc"
alias cfish="cd $HOME && $EDITOR .config/fish/config.fish"
alias caliases="cd $HOME && $EDITOR .aliases"
alias cfunctions="cd $HOME && $EDITOR .functions"
alias ctmux="cd $HOME && $EDITOR .config/tmux/tmux.conf"
alias cbulle="$EDITOR $HOME/.config/bulle/config.yml"
alias cb="$EDITOR $HOME/.config/bulle/config.yml"
alias cportal="$EDITOR $PORTALS/*.yml"
alias csway="$EDITOR $HOME/.config/sway/config"

# Git
if command -v git >/dev/null 2>&1; then
    alias gs="git status"
    alias gp="git push"
    alias ga="git add"
    alias gc="git clone"
    alias gd="git diff"
    alias gb="git branch"
    alias gba="git branch -a"
    alias gco="git checkout"
    alias gr="git rm"
    alias gitu="git add . && git commit"
    alias gitup="git add . && git commit && git push"
    alias gituf='git add . && git commit -m "$(date +"%Y-%m-%d %T")" && git push'
fi

# Build & check
alias mf="make fclean"
alias mfc="make fclean"
alias mr="make re"
alias mre="mr"
command -v valgrind >/dev/null 2>&1 && alias vg="valgrind"
command -v valgrind >/dev/null 2>&1 && alias vgf="valgrind --leak-check=full"
command -v kettle >/dev/null 2>&1 && alias cinit="kettle use c ."

# Tmux
if command -v tmux >/dev/null 2>&1; then
    alias ta="tmux attach"
    alias treload="tmux source-file ~/.config/tmux/tmux.conf"
    alias trel="treload"
    alias tl="tmux ls -f '#{session_name}'"
    alias sl="tmux ls -f '#{session_name}'"
    alias tll="tmux ls"
    alias trs="tmux rename-session -t"
fi

# CLI Tools
command -v egg >/dev/null 2>&1 && alias e="egg"
command -v donut >/dev/null 2>&1 && alias d="donut"
command -v purse >/dev/null 2>&1 && alias p="purse i"
command -v vero >/dev/null 2>&1 && alias v="vero"
command -v mise >/dev/null 2>&1 && alias m="mise"
command -v iamb >/dev/null 2>&1 && alias i="iamb"
command -v rg >/dev/null 2>&1 && alias rg="rg --smart-case"
command -v bat >/dev/null 2>&1 && alias cat="bat"
command -v csvlens >/dev/null 2>&1 && alias csv="csvlens"
command -v zathura >/dev/null 2>&1 && alias za="zathura"
command -v yazi >/dev/null 2>&1 && alias y="yazi"

# AI
command -v agy >/dev/null 2>&1 && alias ay="agy --dangerously-skip-permissions"
command -v claude >/dev/null 2>&1 && alias cy="claude --dangerously-skip-permissions"
command -v codex >/dev/null 2>&1 && alias coy="codex --dangerously-bypass-approvals-and-sandbox"
command -v bulle >/dev/null 2>&1 && alias a="$HARNESS"

# filet
command -v filet >/dev/null 2>&1 && alias fc="filet check ."
command -v filet >/dev/null 2>&1 && alias fr="filet roast ."

command -v hunk >/dev/null 2>&1 && alias hd="hunk diff"
command -v boite >/dev/null 2>&1 && alias bp="boite run pingu"

# Other linux stuff
command -v apk >/dev/null 2>&1 && command -v fzf >/dev/null 2>&1 && alias apk-search="apk search | fzf"
command -v fastfetch >/dev/null 2>&1 && alias neofetch="fastfetch"
command -v kicad >/dev/null 2>&1 && alias kicad="GDK_BACKEND=x11 kicad"

# Extra Package Manager
command -v facile >/dev/null 2>&1 && alias p="facile"

# TUI File explorer
command -v facile >/dev/null 2>&1 && alias f="yazi"
