PROMPT_HOST="$(hostname 2>/dev/null || uname -n 2>/dev/null || printf 'host')"
PROMPT_HOST="${PROMPT_HOST%%.*}"

format_current_git_branch() {
    git_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    if [ -n "$git_branch" ]; then
        printf '(%s)' "$git_branch"
    fi
}

NEWLINE="
"
PROMPT_HOST_COLOR="$(printf '\033[35m')"
PROMPT_PATH_COLOR="$(printf '\033[36m')"
PROMPT_BRANCH_COLOR="$(printf '\033[32m')"
PROMPT_RESET="$(printf '\033[0m')"

if [ -n "${ZSH_VERSION:-}" ]; then
    setopt PROMPT_SUBST 2>/dev/null || true
    # shellcheck disable=SC2016
    export PROMPT="%{${PROMPT_HOST_COLOR}%}${PROMPT_HOST} %{${PROMPT_PATH_COLOR}%}%~%{${PROMPT_RESET}%} "'$(format_current_git_branch)'"%{${PROMPT_RESET}%} ${NEWLINE}%{${PROMPT_BRANCH_COLOR}%}>%{${PROMPT_RESET}%} "
elif [ -n "${BASH_VERSION:-}" ]; then
    # shellcheck disable=SC2016
    export PS1="\[${PROMPT_HOST_COLOR}\]${PROMPT_HOST} \[${PROMPT_PATH_COLOR}\]\w\[${PROMPT_RESET}\] "'$(format_current_git_branch)'"\[${PROMPT_RESET}\] ${NEWLINE}\[${PROMPT_BRANCH_COLOR}\]>\[${PROMPT_RESET}\] "
else
    export PS1="${PROMPT_HOST} > "
fi
