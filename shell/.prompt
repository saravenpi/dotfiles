# Shared prompt for bash and zsh, sourced as ~/.prompt by both.
#
# Layout (identical in both shells):
#   hostname ~/path (branch)
#   >
#
# zsh uses %F/%{..%} escapes with PROMPT_SUBST; bash uses \[..\] escapes and
# renders PS1 each time it is shown, so the $(...) below stays literal here and
# is evaluated at prompt time in both shells.

# Hostname up to the first dot (same as zsh's %m and bash's \h).
PROMPT_HOST="${HOSTNAME:-$(hostname 2>/dev/null)}"
PROMPT_HOST="${PROMPT_HOST%%.*}"

format_current_git_branch() {
    local branch
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || return 0
    [ -n "$branch" ] && printf '(%s)' "$branch"
}

export NEWLINE=$'\n'

# Colors shared by both shells, wrapped in the right escapes below.
PROMPT_HOST_COLOR=$'\033[35m'
PROMPT_PATH_COLOR=$'\033[36m'
PROMPT_BRANCH_COLOR=$'\033[32m'
PROMPT_RESET=$'\033[0m'

if [ -n "${ZSH_VERSION:-}" ]; then
    setopt PROMPT_SUBST
    export PROMPT="%{${PROMPT_HOST_COLOR}%}${PROMPT_HOST} %{${PROMPT_PATH_COLOR}%}%~%{${PROMPT_RESET}%} "'$(format_current_git_branch)'"%{${PROMPT_RESET}%} ${NEWLINE}%{${PROMPT_BRANCH_COLOR}%}>%{${PROMPT_RESET}%} "
elif [ -n "${BASH_VERSION:-}" ]; then
    export PS1="\[${PROMPT_HOST_COLOR}\]${PROMPT_HOST} \[${PROMPT_PATH_COLOR}\]\w\[${PROMPT_RESET}\] "'$(format_current_git_branch)'"\[${PROMPT_RESET}\] ${NEWLINE}\[${PROMPT_BRANCH_COLOR}\]>\[${PROMPT_RESET}\] "
fi
