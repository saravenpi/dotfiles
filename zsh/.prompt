#!/bin/zsh

setopt PROMPT_SUBST

format_current_git_branch() {
  local BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
  if [[ -n ${BRANCH} ]] ; then
    echo "(${BRANCH})"
  fi
}

export NEWLINE=$'\n'

export PROMPT='%F{magenta}ruche %F{cyan}%~%F{reset_color} %F{green}$(format_current_git_branch)%F{reset_color} $NEWLINE%F{green}>%F{reset_color} '
