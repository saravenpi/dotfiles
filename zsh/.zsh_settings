# history
HISTCONTROL=ignoreboth

# default editor (override through tiroir or the environment)
export EDITOR="${EDITOR:-vis}"

# colored GCC warnings and errors
export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'

# local bins
export MYBINS="${MYBINS:-$HOME/mybins}"
[ -d "$MYBINS" ] && export PATH="$MYBINS:$PATH"

# personal scripts
[ -d "$HOME/scripts" ] && export PATH="$HOME/scripts:$PATH"

# locally installed binaries
[ -d "$HOME/.local/bin" ] && export PATH="$HOME/.local/bin:$PATH"

case "$(uname -s)" in
    Darwin)
        export HOMEBREW_CASK_OPTS="--fontdir=$HOME/.fonts"
        [ -d "$HOME/Library/Android/sdk" ] && export ANDROID_HOME="$HOME/Library/Android/sdk"
        ;;
    Linux)
        [ -d "$HOME/Android/Sdk" ] && export ANDROID_HOME="$HOME/Android/Sdk"
        [ -z "${ANDROID_HOME:-}" ] && [ -d "$HOME/Android/sdk" ] && export ANDROID_HOME="$HOME/Android/sdk"
        ;;
esac

[ -n "${ANDROID_HOME:-}" ] && [ -d "$ANDROID_HOME/platform-tools" ] && export PATH="$PATH:$ANDROID_HOME/platform-tools"
[ -d "$HOME/.cargo/bin" ] && export PATH="$HOME/.cargo/bin:$PATH"

export MANPAGER="nvim +Man!"
export TLDR_AUTO_UPDATE_DISABLED="true"
export PATH="$HOME/.bun/bin:$PATH"
bindkey -e
bindkey '^A' beginning-of-line
bindkey '^E' end-of-line
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[1~' beginning-of-line
bindkey '^[[4~' end-of-line
bindkey '^[[7~' beginning-of-line
bindkey '^[[8~' end-of-line
bindkey '^[[3~' delete-char
bindkey '^?' backward-delete-char
bindkey '^H' backward-delete-char
bindkey '^W' backward-kill-word
bindkey '^[^?' backward-kill-word
bindkey '^[^H' backward-kill-word
bindkey '^[d' kill-word
bindkey '^[D' kill-word
bindkey '^[[3;3~' kill-word
bindkey '^[^[[3~' kill-word
bindkey '^[[3;5~' kill-word
bindkey '^[b' backward-word
bindkey '^[f' forward-word
bindkey '^[[1;5D' backward-word
bindkey '^[[1;5C' forward-word
bindkey '^[[1;3D' backward-word
bindkey '^[[1;3C' forward-word
bindkey '^K' kill-line
bindkey '^U' backward-kill-line
bindkey '^_' undo
bindkey '^/' undo
